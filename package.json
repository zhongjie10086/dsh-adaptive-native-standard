{
  "name": "dsh-adaptive-native-standard",
  "version": "0.3.0",
  "private": true,
  "description": "Windows-native Adaptive Standard and Minimal-first presets for DeepSeek Harness",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "preset/",
    "preset-minimal/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhongjie10086/dsh-adaptive-native.git"
  },
  "homepage": "https://github.com/zhongjie10086/dsh-adaptive-native#readme",
  "bugs": {
    "url": "https://github.com/zhongjie10086/dsh-adaptive-native/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent-preset",
    "windows",
    "git-bash",
    "coding-agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "generate:minimal": "node scripts/generate-minimal-preset.mjs",
    "verify:minimal": "node scripts/generate-minimal-preset.mjs --check",
    "test": "node --test",
    "verify": "npm run verify:minimal && node scripts/verify-preset.mjs",
    "verify:dsh": "node scripts/verify-dsh.mjs",
    "check": "npm run verify && npm test"
  }
}
